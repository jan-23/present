{
  "name": "present",
  "version": "1.0.0",
  "private": true,
  "description": "Dead simple local image/video presenter. Open index.html in Chrome/Edge.",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --format=iife --target=es2022 --minify --outfile=dist/present.js",
    "watch": "npm run build -- --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "idb-keyval": "^6.2.1",
    "sortablejs": "^1.15.3"
  },
  "devDependencies": {
    "@types/sortablejs": "^1.15.8",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.2"
  }
}
